{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beerle",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "BeerleRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BeerleRoomDO"]
    }
  ]
}
